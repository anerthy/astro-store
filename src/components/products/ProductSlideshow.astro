---
import 'swiper/css';
import 'swiper/css/pagination';

interface Props {
  images: any[];
}

const { images } = Astro.props;

const fullImages = images.map((img) => {
  return img.image.startsWith('http')
    ? img
    : `${import.meta.env.PUBLIC_URL}/images/products/${img.image}`;
});
---

<div class="swiper mt-10 col-span-1 sm:col-span-2">
  <!-- Additional required wrapper -->
  <div class="swiper-wrapper">
    <!-- Slides -->
    {
      fullImages.map((img) => (
        <div class="swiper-slide">
          <img
            src={img}
            alt={`Product image`}
            class="w-full h-full object-cover px-10"
          />
        </div>
      ))
    }
  </div>
  <div class="swiper-pagination"></div>
</div>

<style>
  .swiper {
    width: 100%;
    height: 600px;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  const swiper = new Swiper('.swiper', {
    pagination: {
      el: '.swiper-pagination',
    },
    modules: [Pagination],
  });
</script>
