---
import MainLayout from '@/layouts/MainLayout.astro';
import { Formatter } from '@/utils/formatter';
import { actions } from 'astro:actions';

const { data: products, error } = await Astro.callAction(
  actions.loadProductsFromCart,
  {}
);

if (error || !products) {
  return Astro.redirect('/');
}

const total = products.reduce(
  (sum, item) => sum + item.price * item.quantity,
  0
);
---

<MainLayout title="Shopping Cart" description="Your shopping cart">
  <h1 class="text-3xl font-bold">Shopping Cart</h1>
  <section class="grid grid-cols-1 sm:grid-cols-2 gap-2">
    <div class="order-2 sm:order-1">
      <h2 class="text-3xl font-bold">Products</h2>
      <a href="javascript:history.back()" class="text-blue-500 hover:underline">
        Back to Shopping
      </a>
      {
        products.map((product) => (
          <div class="flex gap-5 mt-5 items-center">
            <img src={product.image} alt={product.title} class="size-20" />
            <div>
              <a
                href={`/products/${product.slug}`}
                class="text-blue-500 hover:underline"
              >
                {product.title}
              </a>
              <p class="text-gray-600">${product.price.toFixed(2)}</p>
              <p>
                Size: <span class="font-bold">{product.size}</span>
              </p>
              <p>
                Quantity: <span class="font-bold">{product.quantity}</span>
              </p>
              <button
                data-id={product.productId}
                data-size={product.size}
                class="text-red-500 hover:underline btn-delete"
              >
                Remove
              </button>
            </div>
          </div>
        ))
      }
    </div>
    <div class="h-[330px] bg-white text-black p-6 rounded-lg shadow-lg order-1">
      <h2 class="text-lg font-semibold mb-4">Resumen de compra</h2>

      <div class="flex justify-between text-gray-600 mb-2">
        <span>Envío</span>
        <span>Free</span>
      </div>

      <div class="flex justify-between text-gray-600 mb-4">
        <span>Subtotal </span>
        <span>{Formatter.currency(total)}</span>
      </div>
      <div class="flex justify-between text-gray-600 mb-4">
        <span>Impuesto </span>
        <span>{Formatter.currency(total * 0.15)}</span>
      </div>

      <div class="flex justify-between text-xl font-bold">
        <span>Total</span>
        <span>{Formatter.currency(total * 1.15)}</span>
      </div>

      <button
        class="mt-10 w-full bg-blue-700 text-gray-300 py-3 rounded-lg hover:bg-gray-600 transition-all"
      >
        PAGAR
      </button>
    </div>
  </section>
</MainLayout>

<script>
  import { CartCookiesClient } from '@/utils/cart-cookies';
  import { actions } from 'astro:actions';

  const deleteButtons = document.querySelectorAll(
    '.btn-delete'
  ) as NodeListOf<HTMLButtonElement>;

  deleteButtons.forEach((button) => {
    button.addEventListener('click', async (event) => {
      const target = event.target as HTMLButtonElement;

      const productId = target.dataset.id;
      const size = target.dataset.size;
      console.log({ productId, size });

      if (!productId || !size) return;

      CartCookiesClient.removeItem(productId, size);
      // TODO: temporal
      window.location.reload();
    });
  });
</script>
